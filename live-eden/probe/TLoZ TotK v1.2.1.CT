        <CheatEntry>
          <ID>595</ID>
          <Description>"STEP 1"</Description>
          <Options moHideChildren="1" moManualExpandCollapse="1" moAllowManualCollapseAndExpand="1"/>
          <LastState Value="" Activated="1" RealAddress="1F19200000"/>
