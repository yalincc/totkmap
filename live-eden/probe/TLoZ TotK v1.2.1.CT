[ENABLE]
if not getAddressSafe("initcurhp") then
  local initcurhp = allocateMemory(8)
  registerSymbol("initcurhp", initcurhp)
  writeInteger("initcurhp", 0)
end
if not getAddressSafe("initmaxhp") then
  local initmaxhp = allocateMemory(8)
  registerSymbol("initmaxhp", initmaxhp)
  writeInteger("initmaxhp", 0)
end
if not getAddressSafe("initstam") then
  local initstam = allocateMemory(8)
  registerSymbol("initstam", initstam)
  writeFloat("initstam", 0)
end
if not getAddressSafe("initzonrgy") then
  local initzonrgy = allocateMemory(8)
  registerSymbol("initzonrgy", initzonrgy)
  writeFloat("initzonrgy", 0)
end

[DISABLE]
deAlloc('initcurhp')
unregisterSymbol('initcurhp')
deAlloc('initmaxhp')
unregisterSymbol('initmaxhp')
deAlloc('initstam')
unregisterSymbol('initstam')
deAlloc('initzonrgy')
unregisterSymbol('initzonrgy')
</AssemblerScript>
