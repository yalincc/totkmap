                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}

[ENABLE]
local al = getAddressList()
wcx = al.getMemoryRecordByDescription('World Coord X')
wcy = al.getMemoryRecordByDescription('World Coord Y')
wcz = al.getMemoryRecordByDescription('World Coord Z')
bmppo = al.getMemoryRecordByDescription('Back Menu Purah Pad Open')
mlay = al.getMemoryRecordByDescription('Map Layer')
mwcx = al.getMemoryRecordByDescription('Map World Coord X')
mwcz = al.getMemoryRecordByDescription('Map World Coord Z')
mhiid = al.getMemoryRecordByDescription('Map Hover Icon ID')
wcysafecap = 0

t_maptp = createTimer()
t_maptp.setInterval(50)
t_maptp.onTimer = function()
  if tonumber(mlay.Value) == 0 or tonumber(mlay.Value) == 1 then
    wcysafecap = 3200.00
    --wcy.Value = wcysafecap
    --print(ml.Value)
  end
  if tonumber(mlay.Value) == 2 then
    wcysafecap = 0
  end
  ctrlr = getXBox360ControllerState()
  if tonumber(bmppo.Value) ~= 0 and ctrlr.GAMEPAD_LEFT_THUMB then
    wcx.Value = mwcx.Value
    wcy.Value = wcysafecap
    wcz.Value = -(mwcz.Value)
  end
  --val = readInteger('address')
  --writeInteger('newaddress',val)
end

[DISABLE]
t_maptp.Enabled = false
t_maptp.destroy()
</AssemblerScript>
