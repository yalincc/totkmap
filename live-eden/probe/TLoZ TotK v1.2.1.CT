              <LastState Activated="1"/>
              <Color>8000FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

[ENABLE]
local al = getAddressList()
hp = al.getMemoryRecordByDescription('Health')
maxhp = al.getMemoryRecordByDescription('Max Health')

t_health = createTimer()
t_health.setInterval(50)
t_health.onTimer = function()
  if tonumber(hp.Value) ~= tonumber(maxhp.Value) then
    hp.Value = maxhp.Value
  end
end

[DISABLE]
t_health.destroy()
</AssemblerScript>
