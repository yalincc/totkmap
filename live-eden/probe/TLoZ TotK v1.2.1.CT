[ENABLE]
--AUTO FIND STAMINA ADDRESS
local al = getAddressList()
stamina = al.getMemoryRecordByDescription('Stamina')
initstam = readFloat('initstam')
--initstam = al.getMemoryRecordByDescription('What is your current max stamina (1 circle = 1000)')
--"f:300 w:8 f:1000 w:20 f:1000"
stamgs = "f:300 w:8 f:"..initstam.." w:20 f:"..initstam

ms=createMemScan()
fl=createFoundList(ms)
protectionflags = "*W*X-C"
ms.FirstScan(soExactValue, vtGrouped, rtRounded, stamgs,"", 0x10000000000, 0x2ffffffffff,"", fsmAligned,"4", false, false, false, false)
ms.waitTillDone()
fl.initialize()

stamina.Address = fl.Address[0]--1st result
stamina.Address = stamina.CurrentAddress+0x24

fl.destroy()
ms.destroy()

--AUTO FIND HEALTH/MAX HEALTH ADDRESS
local al = getAddressList()
hp = al.getMemoryRecordByDescription('Health')
maxhp = al.getMemoryRecordByDescription('Max Health')
initcurhp = readInteger('initcurhp')
initmaxhp = readInteger('initmaxhp')
--initcurhp = al.getMemoryRecordByDescription('What is your current hp? (1 red heart = 4hp)')
--initmaxhp = al.getMemoryRecordByDescription('What is your max hp? (all hearts x4)')
--"4:150 4:833312128 w:8 4:160 w:204 4:160"
hpgs = "4:"..initcurhp.." 4:833312128 w:8 4:"..initmaxhp.." w:204 4:"..initmaxhp

ms=createMemScan()
fl=createFoundList(ms)
protectionflags = "*W*X-C"
ms.FirstScan(soExactValue, vtGrouped, rtRounded, hpgs,"", 0x10000000000, 0x2ffffffffff,"", fsmAligned,"4", false, false, false, false)
ms.waitTillDone()
fl.initialize()

hp.Address = fl.Address[0]--1st result
maxhp.Address = hp.CurrentAddress+0x10

fl.destroy()
ms.destroy()

--AUTO FIND ZONAI ENERGY ADDRESS
local al = getAddressList()
ze = al.getMemoryRecordByDescription('Zonai Energy')
initzonrgy = readFloat('initzonrgy')
--initzonrgy = al.getMemoryRecordByDescription('What is your current max zonai energy (1 cell = 1000, 1 battery = 3000)')
--"f:150.00 w:8 f:3000.00 f:0 f:3000.00 f:0"
zegs = "f:150.00 w:8 f:"..initzonrgy.." f:0 f:"..initzonrgy.." f:0"

ms=createMemScan()
fl=createFoundList(ms)
protectionflags = "*W*X-C"
ms.FirstScan(soExactValue, vtGrouped, rtRounded, zegs,"", 0x10000000000, 0x2ffffffffff,"", fsmAligned,"4", false, false, false, false)
ms.waitTillDone()
fl.initialize()

ze.Address = fl.Address[1]--2nd result
ze.Address = ze.CurrentAddress+0x14

fl.destroy()
ms.destroy()

--AUTO FIND WORLD COORDS ADDRESS
ms=createMemScan()
fl=createFoundList(ms)
protectionflags = "*W*X-C"
ms.FirstScan(soExactValue, vtGrouped, rtRounded, "d:-293.19 d:131.84  d:-137.19","", 0x10000000000, 0x2ffffffffff,"", fsmAligned,"4", false, false, false, false)
ms.waitTillDone()
fl.initialize()

local al = getAddressList()
wcx = al.getMemoryRecordByDescription('World Coord X')
wcy = al.getMemoryRecordByDescription('World Coord Y')
wcz = al.getMemoryRecordByDescription('World Coord Z')
yvel = al.getMemoryRecordByDescription('Y Velocity')
wcx.Address = fl.Address[0]--1st result
wcy.Address = wcx.CurrentAddress+0x8
wcz.Address = wcy.CurrentAddress+0x8
yvel.Address = wcx.CurrentAddress+0x54

fl.destroy()
ms.destroy()

[DISABLE]

</AssemblerScript>
