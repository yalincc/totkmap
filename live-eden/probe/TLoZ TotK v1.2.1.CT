                  <ID>585</ID>
                  <Description>"Auto Find Stamina, Health, Zonai Energy, &amp; World Coords"</Description>
                  <Options moHideChildren="1"/>
                  <LastState Activated="1"/>
                  <Color>8000FF</Color>
