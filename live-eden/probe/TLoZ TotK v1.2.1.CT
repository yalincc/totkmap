              <CheatEntries>
                <CheatEntry>
                  <ID>600</ID>
                  <Description>"Auto Find Selected Slot Count Display (enable this to get to step 2.a)"</Description>
                  <Options moHideChildren="1"/>
                  <LastState Activated="1"/>
                  <Color>8000FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}

[ENABLE]
--AUTO FIND SELECTED SLOT COUNT DISPLAY ADDRESS
if not getAddressSafe("sscd") then
  local sscd = allocateMemory(8)
  registerSymbol("sscd", sscd)
  writeInteger("sscd", 0xDEADBEEF)
end
if not getAddressSafe("performcalculations") then
  local performcalculations = allocateMemory(8)
  registerSymbol("performcalculations", performcalculations)
  writeInteger("performcalculations", 0xDEADBEEF)
end

ms=createMemScan()
fl=createFoundList(ms)
protectionflags = "*W*X-C"
ms.FirstScan(soExactValue, vtGrouped, rtRounded, "4:1600807503 w:44 4:16 w:60 4:33","", 0x10000000000, 0x2ffffffffff,"", fsmAligned,"4", false, false, false, false)
ms.waitTillDone()
fl.initialize()

local al = getAddressList()
sscd = al.getMemoryRecordByDescription('Selected Slot Count Display')
rnawtv = al.getMemoryRecordByDescription('Recalculate new addresses with this value')
rnawtv.Address = fl.Address[0]--1st result out of 2
writeQword("performcalculations", rnawtv.CurrentAddress+0xA8)
rnawtv.Address = "performcalculations"

fl.destroy()
ms.destroy()

[DISABLE]
deAlloc('sscd')
unregisterSymbol('sscd')
deAlloc('performcalculations')
unregisterSymbol('performcalculations')
</AssemblerScript>
