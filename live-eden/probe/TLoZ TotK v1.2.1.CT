                <CheatEntry>
                  <ID>569</ID>
                  <Description>"Fly"</Description>
                  <Options moHideChildren="1" moAllowManualCollapseAndExpand="1"/>
                  <LastState/>
                  <Color>8000FF</Color>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>{$lua}

[ENABLE]
if not getAddressSafe("flymode") then
  local flymode = allocateMemory(4)
  registerSymbol("flymode", flymode)
  writeInteger("flymode", 0)
end
local al = getAddressList()
wcy = al.getMemoryRecordByDescription('World Coord Y')
yvel = al.getMemoryRecordByDescription('Y Velocity')
fm = al.getMemoryRecordByDescription('Fly Mode')
sd = al.getMemoryRecordByDescription('Sky Diving')

t_fly = createTimer()
t_fly.setInterval(10)
t_fly.onTimer = function()
  ctrlr = getXBox360ControllerState()
  if tonumber(fm.Value) == 0 then --velocity fly mode(hold Y[X if using an xbox controller] to start flying upwards while gliding)
    if tonumber(sd.Value) == 300 and ctrlr.GAMEPAD_X then
      yvel.Value = 331.40
    end
  end
  if tonumber(fm.Value) == 1 then --coordinate increase fly mode(hold Y[X if using an xbox controller] to start flying upwards while gliding)
    if tonumber(sd.Value) == 300 and ctrlr.GAMEPAD_X then
      wcy.Value = wcy.Value+1.00
    end
  end
  if tonumber(fm.Value) == 2 then --coordinate teleport fly mode(hold Y[X if using an xbox controller] to start flying upwards while gliding)
    if tonumber(sd.Value) == 300 and ctrlr.GAMEPAD_X then
      wcy.Value = 3200
    end
  end
end

[DISABLE]
t_fly.destroy()

deAlloc('flymode')
unregisterSymbol('flymode')
</AssemblerScript>
