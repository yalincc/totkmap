              <ID>603</ID>
              <Description>"IMPORTANT PART THAT I SKIPPED: SELECT/HOVER OVER "Wood" IN "Materials" INVENTORY BEFORE ENABLING THIS SCRIPT:"</Description>
              <Options moHideChildren="1"/>
