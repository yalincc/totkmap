[ENABLE]
local al = getAddressList()
stamina = al.getMemoryRecordByDescription('Stamina')

t_stamina = createTimer()
t_stamina.setInterval(50)
t_stamina.onTimer = function()
  if tonumber(stamina.Value) ~= 1000 then
    stamina.Value = 1000
  end
end

[DISABLE]
t_stamina.destroy()
</AssemblerScript>
