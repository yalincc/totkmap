          <CheatEntries>
            <CheatEntry>
              <ID>601</ID>
              <Description>"ENABLE THIS AND FILL OUT THESE 4 QUESTIONS:"</Description>
              <LastState Activated="1"/>
              <Color>8000FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
