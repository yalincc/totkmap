            <CheatEntry>
              <ID>659</ID>
              <Description>"Infinite Weapon Durability (Ghost Equip Method)"</Description>
              <LastState Activated="1"/>
              <Color>8000FF</Color>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}

[ENABLE]
local al = getAddressList()
wse = al.getMemoryRecordByDescription('Weapon Slot Equipped')

t_weaponsdurability = createTimer()
t_weaponsdurability.setInterval(50)
t_weaponsdurability.onTimer = function()
  if tonumber(wse.Value) ~= 21 then
    wse.Value = 21
  end
end

[DISABLE]
t_weaponsdurability.destroy()
</AssemblerScript>
